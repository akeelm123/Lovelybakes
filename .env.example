# Public origin
PUBLIC_APP_URL=http://127.0.0.1:3000

# PostgreSQL OLTP database
DATABASE_URL=postgres://lovelybakes:change-me@127.0.0.1:5432/lovelybakes

# Approved Google administrator
ADMIN_EMAILS=owner@example.com
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Authenticator mode: local for UAT, database for Vercel
ADMIN_LOCAL_MFA=false
ADMIN_DATABASE_MFA=false
ADMIN_TOTP_SECRET=REPLACEWITH32CHARBASE32SECRETXX

# Payment rehearsal remains disabled until Stripe test credentials are supplied
UAT_MODE=true
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
